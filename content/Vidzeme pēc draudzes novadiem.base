views:
  - type: table
    name: Table
    filters:
      and:
        - or:
            - file.inFolder("Dienesta muižas")
            - file.inFolder("Valsts un privātmuižas, pusmuižas")
        - "!draudzes_novads.isEmpty()"
    order:
      - file.name
      - nosaukums_ger
      - nosaukums_rus
      - veids
      - draudzes_novads
  - type: table
    name: View
    filters:
      and:
        - "!draudzes_novads.isEmpty()"
        - or:
            - file.inFolder("Valsts un privātmuižas, pusmuižas")
            - file.inFolder("Dienesta muižas")
    order:
      - file.name
      - nosaukums_ger
      - nosaukums_rus
      - aprinkis_imperija
      - draudzes_novads
    sort: []
    markers: bullet
